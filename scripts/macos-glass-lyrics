#!/usr/bin/env python3
# Bounded lyrics fetcher for macOS Glass Widgets (LRClrc, no API key needed).
#
# Usage: macos-glass-lyrics <artist> <title> [album] [duration_sec]
# Prints one JSON object to stdout:
#   {"synced": "<lrc or \"\">", "plain": "<text or \"\">", "instrumental": bool}
# and exits 0 whether or not lyrics were found (empty strings = none).
# Non-zero exits are transport/usage failures.
#
# Bounds: 8s HTTP timeout, 64 KiB response cap, fixed https host only.
# Lyrics text is validated as decodable text and control-stripped; it is
# still rendered as PlainText by the card.
import json
import sys
import urllib.parse
import urllib.request

HOST = "https://lrclib.net"
TIMEOUT = 8
MAX_BYTES = 64 * 1024
USER_AGENT = "unyxed-macos-glass/0.3.0 (Omarchy desktop widget)"


def get(path, params):
    url = HOST + path + "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as res:
        if res.status != 200:
            return None
        body = res.read(MAX_BYTES + 1)
        if len(body) > MAX_BYTES or not body:
            return None
        return json.loads(body.decode("utf-8", errors="strict"))


def clean(text, cap=20000):
    if not isinstance(text, str):
        return ""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = "".join(c for c in text if c == "\n" or c == "\t" or ord(c) >= 32 or c in "\u200e\u200f")
    text = text.strip()
    return text[:cap]


def main(argv):
    if len(argv) < 3:
        print(json.dumps({"error": "usage: macos-glass-lyrics <artist> <title> [album] [duration]"}))
        return 2
    artist, title = argv[1].strip(), argv[2].strip()
    album = argv[3].strip() if len(argv) > 3 else ""
    try:
        duration = int(float(argv[4])) if len(argv) > 4 else 0
    except (ValueError, IndexError):
        duration = 0
    if not artist or not title:
        print(json.dumps({"synced": "", "plain": "", "instrumental": False}))
        return 0

    out = {"synced": "", "plain": "", "instrumental": False}
    try:
        params = {"artist_name": artist, "track_name": title}
        if album:
            params["album_name"] = album
        if duration > 0:
            params["duration"] = duration
        hit = get("/api/get", params)
        if hit is None:
            results = get("/api/search", {"q": artist + " " + title,
                                          "track_name": title,
                                          "artist_name": artist})
            if isinstance(results, list):
                hit = next((r for r in results if isinstance(r, dict) and r.get("syncedLyrics")), None)
                if hit is None:
                    hit = next((r for r in results if isinstance(r, dict) and r.get("plainLyrics")), None)
        if isinstance(hit, dict):
            out["instrumental"] = hit.get("instrumental") is True
            out["synced"] = clean(hit.get("syncedLyrics") or "")
            out["plain"] = clean(hit.get("plainLyrics") or "")
    except Exception:
        pass
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
